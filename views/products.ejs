<%- include("partials/navbar") %>

<main>

<h1>Daftar Produk</h1>

<% products.forEach(product=>{ %>

<article>

<h2><%= product.name %></h2>

<p>Kategori : <%= product.category %></p>

<p>Harga : Rp <%= product.price %></p>

<p>Stok : <%= product.stock %></p>

<a href="/produk/<%= product.id %>">

Lihat Detail

</a>

</article>

<hr>

<% }) %>

</main>

<%- include("partials/footer") %>