<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Admin</title>

    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<%- include("partials/navbar") %>

<main>

<section>

<h1>Dashboard Admin</h1>

<button id="logoutBtn">
Logout
</button>

<hr>

<h2>Tambah Produk</h2>

<form id="productForm">

<input
id="name"
placeholder="Nama Produk"
required>

<input
id="category"
placeholder="Kategori"
required>

<input
id="price"
type="number"
placeholder="Harga"
required>

<input
id="stock"
type="number"
placeholder="Stok"
required>

<button type="submit">

Tambah Produk

</button>

</form>

<hr>

<h2>Daftar Produk</h2>

<div id="productList">

</div>

</section>

</main>

<%- include("partials/footer") %>

<script src="/js/dashboard.js"></script>

</body>
</html>