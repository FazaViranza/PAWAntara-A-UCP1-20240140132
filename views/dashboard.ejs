<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Dashboard Admin - Toko Sembako Ariesta</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include("partials/navbar") %>

    <main class="dashboard-main">

        <!-- HEADER -->
        <section class="dashboard-header">

            <div>
                <span class="dashboard-label">ADMIN PANEL</span>

                <h1>Dashboard</h1>

                <p>
                    Kelola produk, harga, dan stok Toko Sembako Ariesta.
                </p>
            </div>

            <button id="logoutBtn" class="logout-button">
                Logout
            </button>

        </section>


        <!-- PRODUCT FORM -->
        <section class="dashboard-form-section">

            <div class="section-heading">

                <div>
                    <span class="section-label">PRODUCT MANAGEMENT</span>

                    <h2 id="formTitle">
                        Tambah Produk
                    </h2>

                    <p id="formDescription">
                        Tambahkan produk baru ke dalam katalog toko.
                    </p>
                </div>

            </div>


            <form id="productForm" class="product-form">

                <div class="form-field">

                    <label for="name">
                        Nama Produk
                    </label>

                    <input
                        id="name"
                        type="text"
                        placeholder="Contoh: Beras Premium 5kg"
                        required>

                </div>


                <div class="form-field">

                    <label for="category">
                        Kategori
                    </label>

                    <input
                        id="category"
                        type="text"
                        placeholder="Contoh: Beras"
                        required>

                </div>


                <div class="form-field">

                    <label for="price">
                        Harga
                    </label>

                    <input
                        id="price"
                        type="number"
                        placeholder="75000"
                        min="0"
                        required>

                </div>


                <div class="form-field">

                    <label for="stock">
                        Stok
                    </label>

                    <input
                        id="stock"
                        type="number"
                        placeholder="20"
                        min="0"
                        required>

                </div>


                <div class="form-actions">

                    <button
                        type="submit"
                        id="submitBtn">
                        Tambah Produk
                    </button>

                    <button
                        type="button"
                        id="cancelBtn"
                        class="cancel-btn"
                        hidden>
                        Batal
                    </button>

                </div>

            </form>

        </section>


        <!-- PRODUCT LIST -->
        <section class="dashboard-products">

            <div class="section-heading">

                <div>
                    <span class="section-label">INVENTORY</span>

                    <h2>Daftar Produk</h2>

                    <p>
                        Kelola produk yang tersedia di toko.
                    </p>
                </div>

            </div>


            <div id="productList" class="dashboard-product-grid"></div>

        </section>

    </main>


    <%- include("partials/footer") %>


    <script src="/js/dashboard.js"></script>
    <script src="/js/script.js"></script>

</body>

</html>