<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= product ? product.name : "Produk Tidak Ditemukan" %> - Toko Sembako Ariesta
    </title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include("partials/navbar") %>

    <main>

        <% if (!product) { %>

            <section class="detail-empty">

                <h1>Produk Tidak Ditemukan</h1>

                <p>
                    Produk yang kamu cari tidak tersedia.
                </p>

                <a href="/produk" class="btn">
                    ← Kembali ke Produk
                </a>

            </section>

        <% } else { %>

            <a href="/produk" class="back-link">
                ← Kembali ke Produk
            </a>

            <section class="product-detail">

                <div class="product-detail-content">

                    <span class="product-category">
                        <%= product.category %>
                    </span>

                    <h1>
                        <%= product.name %>
                    </h1>

                    <p class="product-description">
                        Produk sembako berkualitas dari Toko Sembako Ariesta.
                    </p>

                    <div class="product-price">
                        Rp <%= product.price.toLocaleString("id-ID") %>
                    </div>

                    <div class="product-stock">

                        <% if (product.stock > 0) { %>

                            <span class="stock-badge available">
                                ✓ Stok tersedia
                            </span>

                            <span>
                                <%= product.stock %> unit tersedia
                            </span>

                        <% } else { %>

                            <span class="stock-badge unavailable">
                                Stok habis
                            </span>

                        <% } %>

                    </div>

                    <div class="product-detail-actions">

                        <a href="/produk" class="btn">
                            Lihat Produk Lain
                        </a>

                    </div>

                </div>

            </section>

        <% } %>

    </main>

    <%- include("partials/footer") %>

    <script src="/js/script.js"></script>

</body>

</html>